{
  "entities": {
    "WarehouseItem": {
      "title": "WarehouseItem",
      "description": "An item in the warehouse with current stock level and location",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sku": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "rack": { "type": "string" },
        "stock": { "type": "number" },
        "initialStock": { "type": "number" },
        "targetDailyRate": { "type": "number" }
      },
      "required": ["id", "sku", "name", "category", "rack", "stock"]
    },
    "StockMutation": {
      "title": "StockMutation",
      "description": "A record of stock addition or deduction",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "itemId": { "type": "string" },
        "itemName": { "type": "string" },
        "type": { "type": "string", "enum": ["masuk", "keluar"] },
        "quantity": { "type": "number" },
        "pic": { "type": "string" },
        "time": { "type": "string" },
        "date": { "type": "string" }
      },
      "required": ["id", "itemId", "itemName", "type", "quantity", "pic", "time", "date"]
    },
    "PreOrder": {
      "title": "PreOrder",
      "description": "An item pre-order or purchase order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "itemId": { "type": "string" },
        "itemName": { "type": "string" },
        "poCode": { "type": "string" },
        "orderDate": { "type": "string" },
        "totalQty": { "type": "number" },
        "receivedQty": { "type": "number" },
        "status": { "type": "string", "enum": ["Pending", "Partial", "Complete"] },
        "receivingHistory": { "type": "array" },
        "vendor": { "type": "string" }
      },
      "required": ["id", "itemId", "itemName", "poCode", "orderDate", "totalQty", "receivedQty", "status", "receivingHistory"]
    },
    "SystemNotification": {
      "title": "SystemNotification",
      "description": "A notification generated by the system",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["info", "warning", "success"] },
        "time": { "type": "string" },
        "isRead": { "type": "boolean" },
        "linkToTab": { "type": "string" }
      },
      "required": ["id", "title", "message", "type", "time", "isRead"]
    }
  },
  "firestore": {
    "/items/{itemId}": {
      "schema": "WarehouseItem",
      "description": "Collection of warehouse stock items"
    },
    "/mutations/{mutationId}": {
      "schema": "StockMutation",
      "description": "Collection of stock adjustment and mutation logs"
    },
    "/preorders/{preorderId}": {
      "schema": "PreOrder",
      "description": "Collection of incoming preorders/PO track records"
    },
    "/notifications/{notificationId}": {
      "schema": "SystemNotification",
      "description": "Collection of system notifications and alerts"
    }
  }
}
